{
    "manifest_version": 3,
    "name": "LeetCode Time Complexity Analyzer",
    "version": "1.0",
    "description": "Analyze time complexity of LeetCode solutions instantly!",
    "permissions": [
      "activeTab",
      "scripting",
      "tabs"
    ],
    "host_permissions": [
      "https://leetcode.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://leetcode.com/*"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }
  